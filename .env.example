# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env al repositorio.

# SQL Server (mín. 8 caracteres, mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_123!

# JWT: clave aleatoria de al menos 32 caracteres (p. ej. `openssl rand -base64 48`)
JWT_KEY=reemplazar-por-una-clave-aleatoria-larga-de-al-menos-32-caracteres

# Usuario administrador inicial
SEED_ADMIN_EMAIL=admin@projectm.local
SEED_ADMIN_PASSWORD=Admin_Cambiar_123!

# Datos demo (true/false) y contraseña común de los usuarios demo
SEED_DEMO=true
SEED_DEMO_PASSWORD=Demo_Cambiar_123!

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Puerto público del frontend
WEB_PORT=8080
