# Copia este archivo a .env y COMPLETA todos los valores. NUNCA subas .env al repositorio.
# Genera secretos aleatorios con:  openssl rand -base64 48
# La API se niega a arrancar (fuera de Development) si detecta valores de ejemplo conocidos.

# PostgreSQL local de Docker Compose (en producción se usa Supabase)
POSTGRES_PASSWORD=

# JWT: clave aleatoria de al menos 32 caracteres
JWT_KEY=

# Usuario administrador inicial. La contraseña (≥ 10 caracteres, con mayúscula, minúscula y número)
# debe cambiarse en el primer ingreso; luego puedes borrar estas dos variables.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Datos de demostración: SOLO para entornos locales o de prueba (crea usuarios @projectm.demo
# que comparten la contraseña SEED_DEMO_PASSWORD).
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Zona horaria del equipo (IANA) para calcular "hoy", vencimientos y fechas reales
APP_TIMEZONE=America/Bogota

# Cookie de sesión solo por HTTPS. Déjalo en true (localhost funciona); false solo si sirves por HTTP fuera de localhost.
AUTH_SECURE_COOKIES=true

# Puerto público del frontend
WEB_PORT=8080
